; Cozy Sora — an original procedural Godot 4 game.
config_version=5

[application]
config/name="Cozy Sora"
config/description="An original procedural Godot game inspired by Japanese coastal summers and cozy exploration games."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
textures/default_filters/anisotropic_filtering_level=3

[audio]
driver/enable_input=false

[shader_globals]
cat_position={
"type": "vec3",
"value": Vector3(0,-100,0)
}

[input_devices]
pointing/emulate_mouse_from_touch=true
