; Cozy Sora — an original procedural Godot 4 game.
config_version=5

[application]
config/name="Cozy Sora"
config/description="An original procedural coastal exploration game with Seabreeze Village, Harbor Hills and Daan Gardens."
run/main_scene="res://main.tscn"
run/max_fps=60
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=3

[audio]
driver/enable_input=false

[shader_globals]
cat_position={
"type": "vec3",
"value": Vector3(0,-100,0)
}

[input_devices]
pointing/emulate_mouse_from_touch=true

[dotnet]
project/assembly_name="CozySora"
