text = "REDUCED CAMERA MOTION"

[node name="LookSensitivity" type="HBoxContainer" parent="HUD/PauseOverlay/PausePanel/Content"]
theme_override_constants/separation = 12

[node name="Label" type="Label" parent="HUD/PauseOverlay/PausePanel/Content/LookSensitivity"]
custom_minimum_size = Vector2(150, 0)
text = "LOOK SENSITIVITY"

[node name="Slider" type="HSlider" parent="HUD/PauseOverlay/PausePanel/Content/LookSensitivity"]
custom_minimum_size = Vector2(0, 30)
size_flags_horizontal = 3
min_value = 0.5
max_value = 2.0
step = 0.1
value = 1.0

[node name="MasterVolume" type="HBoxContainer" parent="HUD/PauseOverlay/PausePanel/Content"]
theme_override_constants/separation = 12

[node name="Label" type="Label" parent="HUD/PauseOverlay/PausePanel/Content/MasterVolume"]
custom_minimum_size = Vector2(150, 0)
text = "MASTER VOLUME"

[node name="Slider" type="HSlider" parent="HUD/PauseOverlay/PausePanel/Content/MasterVolume"]
custom_minimum_size = Vector2(0, 30)
size_flags_horizontal = 3
max_value = 1.0
step = 0.05
value = 0.8

[node name="Resume" type="Button" parent="HUD/PauseOverlay/PausePanel/Content"]
