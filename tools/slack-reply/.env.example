SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_USER_TOKEN=xoxp-...
SLACK_USER_ID=U0123456789
SLACK_REPLY_PROVIDER=codex
# default or fast; keeps the same model and reasoning effort.
SLACK_REPLY_TIER=default
SLACK_REPLY_WORKSPACE=/absolute/path/to/workspace
# Optional overrides for the selected provider; unset values use CLI defaults.
# Use a model identifier supported by SLACK_REPLY_PROVIDER.
# SLACK_REPLY_MODEL=your-model-id
# SLACK_REPLY_REASONING_EFFORT=high
