SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_USER_TOKEN=xoxp-...
SLACK_USER_ID=U0123456789
SLACK_REPLY_PROVIDER=codex
# default or fast; keeps the same model and reasoning effort.
SLACK_REPLY_TIER=default
SLACK_REPLY_WORKSPACE=/absolute/path/to/default/workspace
# Aliases match complete words anywhere after bot/chat/claude, ignoring case.
# Keep personal paths in .env only. The first alias mentioned selects the workspace.
# SLACK_REPLY_PROJECTS='{"project":"/absolute/path/to/project","service":"/absolute/path/to/service"}'
# bot uses the provider above and these optional overrides; unset values use CLI defaults.
# chat always uses Codex / gpt-6.1-sol / high.
# claude always uses Claude Code / claude-opus-5-5 / high.
# Use a model identifier supported by SLACK_REPLY_PROVIDER.
# SLACK_REPLY_MODEL=your-model-id
# SLACK_REPLY_REASONING_EFFORT=high
