SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_USER_TOKEN=xoxp-...
SLACK_USER_ID=U0123456789
# Each keyword selects its own CLI settings. Only messages from SLACK_USER_ID can trigger it.
# Optional fields: model, reasoning_effort, tier (default or fast). Omit them to use CLI defaults.
SLACK_REPLY_COMMANDS='{"chat":{"provider":"codex","model":"gpt-6.1-sol","reasoning_effort":"high"},"claude":{"provider":"claude","model":"claude-opus-5-5","reasoning_effort":"high"}}'
SLACK_REPLY_WORKSPACE=/absolute/path/to/default/workspace
# Aliases match complete words anywhere after the command keyword, ignoring case.
# Keep personal paths in .env only. The first alias mentioned selects the workspace.
# SLACK_REPLY_PROJECTS='{"project":"/absolute/path/to/project","service":"/absolute/path/to/service"}'
