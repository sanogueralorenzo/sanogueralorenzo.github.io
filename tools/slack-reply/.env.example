SLACK_APP_TOKEN=xapp-...
SLACK_USER_TOKEN=xoxp-...
SLACK_USER_ID=U0123456789
# Each keyword selects a CLI, which loads its native settings for the workspace.
# Only messages from SLACK_USER_ID can trigger it.
SLACK_REPLY_COMMANDS='{"chat":"codex","claude":"claude"}'
SLACK_REPLY_WORKSPACE=/absolute/path/to/default/workspace
# Aliases match complete words anywhere after the command keyword, ignoring case.
# Keep personal paths in .env only. The first alias mentioned selects the workspace.
# SLACK_REPLY_PROJECTS='{"project":"/absolute/path/to/project","service":"/absolute/path/to/service"}'
