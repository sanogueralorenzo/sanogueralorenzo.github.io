SLACK_APP_TOKEN=xapp-...
SLACK_USER_TOKEN=xoxp-...
SLACK_USER_ID=U0123456789
# Each keyword selects executable argument arrays; prompts arrive on stdin.
# Only messages from SLACK_USER_ID can trigger it.
# Keywords match without case sensitivity: chat, Chat, and CHAT are equivalent.
AGENT_SLACK_COMMANDS='{
  "chat":{"start":["./wrappers/codex.py"],"resume":["./wrappers/codex.py","{session_id}"]},
  "claude":{"start":["./wrappers/claude.py"],"resume":["./wrappers/claude.py","{session_id}"]}
}'
AGENT_SLACK_WORKSPACE=/absolute/path/to/default/workspace
# Aliases match complete words anywhere after the command keyword, ignoring case.
# Keep personal paths in .env only. The first alias mentioned selects the workspace.
# AGENT_SLACK_PROJECTS='{"project":"/absolute/path/to/project","service":"/absolute/path/to/service"}'
# AGENT_SLACK_STATE_DIR=~/.local/state/agent-slack
