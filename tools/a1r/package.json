{
  "name": "a1r",
  "version": "0.3.0",
  "description": "A quiet local assistant runtime for personal and coding work.",
  "private": true,
  "type": "module",
  "bin": {
    "a1r": "dist/bin/a1r.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx src/bin/a1r.ts chat --dev",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bin/a1r.js chat",
    "serve": "tsx src/bin/a1r.ts serve",
    "telegram": "tsx src/bin/a1r.ts telegram",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "macos:build": "swift build --package-path macos",
    "macos:run": "swift run --package-path macos A1RMac"
  },
  "dependencies": {
    "grammy": "^1.40.0",
    "openai": "^6.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
