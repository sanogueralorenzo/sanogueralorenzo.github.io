{
  "name": "@palette/core",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:daemon": "esbuild src/node-daemon.ts --bundle --platform=node --format=esm --outfile=dist/node/node-daemon.mjs",
    "build:indexer": "cargo build --release --manifest-path native/rust-indexer/Cargo.toml",
    "build:linux-host": "cargo build --release --manifest-path native/linux-host/Cargo.toml",
    "daemon": "node --experimental-strip-types src/node-daemon.ts",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "vite": "^5.4.0"
  }
}
