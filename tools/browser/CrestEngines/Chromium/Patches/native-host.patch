+  std::unique_ptr<content::ScopedAccessibilityMode> _voiceover_mode;
+  std::unique_ptr<content::ScopedAccessibilityMode> _general_mode;
+  BOOL _accessibility_ready;
+  BOOL _voiceover_enabled;
+  int _enhanced_requests;
+}
+
+- (void)processEvent:(NSEvent*)event forwarding:(void (NS_NOESCAPE ^)(void))forwarding {
+  base::apple::CallWithEHFrame(^{
+    base::mac::ScopedSendingEvent sending_event;
+    content::ScopedNotifyNativeEventProcessorObserver notify(&self->_observers, event);
+    const bool jis_key = event.type == NSEventTypeKeyDown &&
+        (event.keyCode == kVK_JIS_Eisu || event.keyCode == kVK_JIS_Kana);
+    const bool command_key_up = event.type == NSEventTypeKeyUp &&
+        (event.modifierFlags & NSEventModifierFlagCommand) &&
+        base::FeatureList::IsEnabled(kForwardCmdKeyUpEventsToWindow);
+    if (jis_key || command_key_up)
+      [NSApp.keyWindow sendEvent:event];
+    else
+      forwarding();
+  });
+}
+
+- (void)addObserver:(void*)observer {
+  _observers.AddObserver(static_cast<content::NativeEventProcessorObserver*>(observer));
+}
+
+- (void)removeObserver:(void*)observer {
+  _observers.RemoveObserver(static_cast<content::NativeEventProcessorObserver*>(observer));
+}
+
+- (BOOL)observeKey:(NSString*)key value:(id)value context:(void*)context {
+  if (![key isEqualToString:@"voiceOverEnabled"] ||
+      context != content::BrowserAccessibilityState::GetInstance())
+    return NO;
+  _accessibility_ready = YES;
+  _voiceover_enabled = [value boolValue];
+  [self enableCompleteMode:_voiceover_enabled];
+  return YES;
+}
+
+- (void)enableCompleteMode:(BOOL)enabled {
+  if (enabled) {
+    if (!_voiceover_mode)
+      _voiceover_mode = content::BrowserAccessibilityState::GetInstance()
+          ->CreateScopedModeForProcess(ui::kAXModeComplete |
+                                       ui::AXMode::kFromPlatform |
+                                       ui::AXMode::kScreenReader);
+  } else {
+    _voiceover_mode.reset();
+  }
+}
+
+- (void)prepareAccessibility {
+  if (!_accessibility_ready || _general_mode || _voiceover_mode) return;
+  const ui::AXMode mode = base::FeatureList::IsEnabled(
+      features::kSonomaAccessibilityActivationRefinements)
+      ? ui::AXMode::kNativeAPIs : ui::kAXModeBasic;
+  _general_mode = content::BrowserAccessibilityState::GetInstance()
+      ->CreateScopedModeForProcess(mode | ui::AXMode::kFromPlatform);
+}
+
+- (void)setEnhancedAccessibility:(BOOL)enabled {
+  if (!_accessibility_ready || _voiceover_enabled) return;
+  if (!enabled && _enhanced_requests == 0) {
+    [self enableCompleteMode:NO];
+    return;
+  }
+  _enhanced_requests += enabled ? 1 : -1;
+  [NSObject cancelPreviousPerformRequestsWithTarget:self
+      selector:@selector(enableCompleteModeAfterDelay) object:nil];
+  if (_enhanced_requests > 0)
+    [self performSelector:@selector(enableCompleteModeAfterDelay)
+               withObject:nil afterDelay:2.0];
+}
+
+- (void)enableCompleteModeAfterDelay {
+  _enhanced_requests = 0;
+  [self enableCompleteMode:YES];
+}
+
+- (id)focusedAccessibilityElement {
+  return ui::AccessibilityFocusOverrider::GetFocusedUIElement();
+}
+@end
+
+namespace {
+void AttachCrestApplicationEvents() {
+  CHECK([NSApp conformsToProtocol:@protocol(CrestEngineApplicationHosting)]);
+  [(id<CrestEngineApplicationHosting>)NSApp attachApplicationEvents:
+      [[CrestApplicationEvents alloc] init]];
+}
