+// Whether ScreenCaptureKit refused a call because Crest lacks Screen Recording
+// access. Asking again cannot succeed until the person allows it, and each ask
+// can raise the system's prompt, so the capturer stops rather than retry.
+bool DeclinedAccess(NSError* error) {
+  if (!error) {
+    return false;
+  }
+  if (@available(macOS 13.0, *)) {
+    if ([error.domain isEqualToString:SCStreamErrorDomain] &&
+        error.code == SCStreamErrorUserDeclined) {
+      return true;
+    }
+  }
+  return !CGPreflightScreenCaptureAccess();
+}
