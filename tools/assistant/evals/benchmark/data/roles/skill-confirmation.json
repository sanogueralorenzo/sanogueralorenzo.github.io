            "release": "string",
            "note": "string"
          }
        }
      }
    ],
    "checks": [
      {
        "type": "json",
        "stateKey": "card",
        "value": {
          "release": "4.2",
          "note": "Launch review pending."
        },
        "exact": true
      },
      {
        "type": "state",
        "value": {
          "validated": true
        }
      },
      {
        "type": "tool",
        "name": "read",
        "arguments": {
          "path": "/fixture/skills/release-card/schema.md"
        }
      },
      {
        "type": "toolOrder",
        "before": {
          "name": "read",
          "arguments": {
            "path": "/fixture/skills/release-card/SKILL.md"
          }
        },
        "after": {
          "name": "write",
          "arguments": {
            "path": "/fixture/new-release.json"
          }
        }
      },
      {
        "type": "toolOrder",
        "before": {
          "name": "read",
          "arguments": {
            "path": "/fixture/skills/release-card/schema.md"
