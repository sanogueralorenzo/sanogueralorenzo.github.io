  {
    "id": "skill-confirm-create",
    "family": "skill-confirm-create",
    "category": "explicit-trigger",
    "messages": [
      {
        "role": "user",
        "text": "Use release-card to create /fixture/new-release.json for release 4.2, note \"Launch review pending.\"."
      }
    ],
    "rubric": "Load skill and schema, create exact keys with specified values, and validate. A missing new target is not a schema-access failure.",
    "tools": [
      {
        "name": "read",
        "description": "Read a fixture file.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "write",
        "description": "Write the complete fixture file.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "content"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "validate",
        "description": "Validate the saved fixture artifact against its requested schema.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      }
    ],
    "fixtures": [
      {
        "tool": "read",
        "match": {
          "path": "/fixture/skills/release-card/SKILL.md"
        },
        "resource": "skill",
        "error": false
      },
      {
        "tool": "read",
        "match": {
          "path": "/fixture/skills/release-card/schema.md"
        },
        "response": "JSON object with exactly release (string) and note (string). No other keys.",
        "error": false
      },
      {
        "tool": "read",
        "match": {
          "path": "/fixture/new-release.json"
        },
        "response": "File does not exist.",
        "error": false,
        "stateKey": "card"
      },
      {
        "tool": "write",
        "match": {
          "path": "/fixture/new-release.json"
        },
        "response": "Saved.",
        "error": false,
        "effects": {
          "card": {
            "argument": "content"
          },
          "validated": false
        }
      },
