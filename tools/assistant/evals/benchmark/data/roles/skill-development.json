        "value": {
          "release": "2.0",
          "note": "Keep my note!"
        },
        "exact": true
      },
      {
        "type": "state",
        "value": {
          "validated": true
        }
      },
      {
        "type": "tool",
        "name": "read",
        "arguments": {
          "path": "/fixture/skills/release-card/SKILL.md"
