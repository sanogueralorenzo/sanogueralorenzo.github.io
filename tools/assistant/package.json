{
  "name": "assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=26" },
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts web/*.test.js",
    "eval:suggestions": "node --experimental-strip-types evals/prompt-suggestions/run.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
