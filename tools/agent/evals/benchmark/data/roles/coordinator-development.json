    "messages": [
      {
        "role": "user",
        "text": "Current workspace: /fixture/project\nRecent saved conversations: [{\"id\": \"outline\", \"title\": \"Outline\", \"status\": \"idle\", \"cwd\": \"/fixture/project\"}, {\"id\": \"schedule\", \"title\": \"Schedule\", \"status\": \"running\", \"cwd\": \"/fixture/project\"}]\nMost recent Home exchange: {\"sessionId\": \"outline\", \"request\": \"Shorten outline\", \"reply\": \"I can shorten it.\"}\nOriginal user message (verbatim):\nHelp plan a picnic.\n\nCall route_home once for the entire message."
