              "type": "string"
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "read_conversation",
        "description": "Read a listed conversation by saved session id.",
        "parameters": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string"
            }
          },
          "required": [
            "sessionId"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "route_home",
        "description": "Choose one start or continue destination. Accepted destinations end this routing task.",
        "parameters": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "start",
                "continue"
              ]
            },
            "title": {
              "type": "string"
            },
            "sessionId": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        }
      }
    ],
    "fixtures": [
      {
        "tool": "route_home",
        "match": {},
        "response": "Destination accepted.",
        "effects": {
          "routeMode": {
            "argument": "mode"
          },
          "routeSession": {
            "argument": "sessionId"
          },
          "routeCwd": {
            "argument": "cwd"
          }
        },
        "terminal": true,
        "validate": [
          {
            "type": "nonempty",
            "key": "title",
            "when": {
              "mode": "start"
            },
            "message": "New work needs a title"
          },
          {
            "type": "absent",
            "key": "sessionId",
            "when": {
              "mode": "start"
            },
            "message": "New work cannot use a saved session ID"
          },
          {
            "type": "enum",
            "key": "sessionId",
            "values": [
              "outline",
              "schedule",
              "archive"
            ],
            "when": {
              "mode": "continue"
            },
            "message": "Continue with an exact saved ID"
          }
        ]
      }
    ],
    "initialState": {},
    "checks": [
      {
        "type": "state",
        "value": {
          "routeMode": "start"
        }
      },
      {
        "type": "absent",
        "keys": [
          "routeCwd"
        ]
      }
    ]
  },
