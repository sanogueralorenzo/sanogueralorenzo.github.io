[
  {
    "id": "session-confirm-toggle",
    "family": "session-confirm-toggle",
    "category": "scoped-edit",
    "messages": [
      {
        "role": "user",
        "text": "Enable compact mode in /fixture/preferences.json; leave labels and my note as they are."
      }
    ],
    "rubric": "Inspect the file, change compact to true, preserve exact labels and note, and report actual result.",
    "tools": [
      {
        "name": "read",
        "description": "Read a fixture file.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "write",
        "description": "Write the complete fixture file.",
        "parameters": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "content"
          ],
          "additionalProperties": false
        }
      }
    ],
    "fixtures": [
      {
        "tool": "read",
        "match": {
          "path": "/fixture/preferences.json"
        },
        "response": "{\"compact\":false,\"labels\":[\"red\",\"blue\"],\"note\":\"Keep this draft.\"}",
        "error": false,
        "stateKey": "file"
      },
      {
        "tool": "write",
        "match": {
          "path": "/fixture/preferences.json"
        },
        "response": "Saved.",
        "error": false,
        "effects": {
          "file": {
            "argument": "content"
          }
        }
      }
    ],
    "checks": [
      {
        "type": "json",
        "stateKey": "file",
        "value": {
          "compact": true,
          "labels": [
            "red",
            "blue"
          ],
          "note": "Keep this draft."
        },
        "exact": true
      }
    ],
    "initialState": {
      "file": "{\"compact\":false,\"labels\":[\"red\",\"blue\"],\"note\":\"Keep this draft.\"}"
    }
  },
