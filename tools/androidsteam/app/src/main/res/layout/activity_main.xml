<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/screen_padding">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textColor="@color/foreground" android:textSize="32sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/tagline" android:textColor="@color/secondary" android:textSize="17sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="40dp" android:text="@string/device_heading" android:textColor="@color/accent" android:textSize="14sp" />
        <TextView android:id="@+id/device" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textColor="@color/foreground" android:textSize="18sp" />
        <TextView android:id="@+id/runtime_heading" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="32dp" android:text="@string/runtime_heading" android:textColor="@color/foreground" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textColor="@color/secondary" android:textSize="16sp" />
        <Button android:id="@+id/action" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:minHeight="56dp" />
        <TextView android:id="@+id/development_notice" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/development_notice" android:textColor="@color/secondary" android:textSize="14sp" />
        <Button android:id="@+id/start_steam" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:minHeight="56dp" android:text="@string/start_steam" />
        <Button android:id="@+id/game_settings" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:minHeight="48dp" android:text="@string/game_settings" />
    </LinearLayout>
</ScrollView>
